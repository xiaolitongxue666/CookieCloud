# 复制为 cookiecloud.local.env（勿提交）。扩展与 rss sync 脚本共用。
# 生成示例：
#   UUID=$(python3 -c 'import uuid; print(uuid.uuid4().hex[:16])')
#   PASS=$(openssl rand -hex 12)
COOKIE_CLOUD_UUID=
COOKIE_CLOUD_PASSWORD=
# 容器内/本机环回（rss sync 在 VPS 上跑时用这个）
COOKIE_CLOUD_HOST=http://127.0.0.1:8088/cookiecloud
# 浏览器扩展（本机 Tailscale）用：
# COOKIE_CLOUD_HOST=http://100.74.201.82:8088/cookiecloud
COOKIE_CLOUD_CRYPTO_TYPE=legacy
